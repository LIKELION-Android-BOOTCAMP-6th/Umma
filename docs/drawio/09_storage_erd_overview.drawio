        <mxCell id="tbl_turns" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#0F172A;fontSize=13;align=left;spacing=12;" value="session_turns&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PK: turnId&lt;br&gt;row: 대화 turn 1개&lt;br&gt;sessionId / userId / language&lt;br&gt;text / role / createdAt&lt;br&gt;durationMs / tokenCount / confidence&lt;br&gt;syncStatus&lt;/span&gt;" vertex="1">
          <mxGeometry height="180" width="330" x="890" y="225" as="geometry" />
