rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 모든 규칙은 Firebase Auth 로그인 사용자를 기준으로 판단한다.
    // Google Play 배포 전에는 기본 open 규칙을 없애고, 명시한 경로만 허용해야 한다.
    function isSignedIn() {
      return request.auth != null;
    }

    // users/{uid} 아래의 개인 데이터는 문서 경로의 uid와 로그인 uid가 같을 때만 접근시킨다.
    // 앱 코드도 같은 사용자 경계를 확인하지만, 클라이언트 방어만으로는 변조 요청을 막을 수 없다.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Chat usage 집계 문서는 Android가 직접 쓰지 않고 Cloud Function Admin SDK가 생성한다.
    // Firestore Rules의 allow는 여러 match가 겹치면 OR로 평가되므로, 서버 전용 컬렉션은
    // generic users/{uid} 하위 write 허용 조건에서 명시적으로 제외해야 한다.
    function isClientWritableUserCollection(collectionId) {
      return collectionId != "chat_usage_sessions"
        && collectionId != "chat_usage_monthly";
    }

    // 운영용 AI 신고는 루트 컬렉션에 저장된다.
    // 신고자는 본인 uid로만 문서를 만들 수 있어야 하고, 운영 처리 상태는 앱에서 직접 바꾸면 안 된다.
    function isValidAiContentReportCreate() {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "New";
    }

    // 사용자 프로필 루트 문서입니다.
    // 최초 설정과 관심 주제 변경은 클라이언트가 수행하므로 create/update/read는 허용한다.
    // 계정 삭제는 Cloud Function Admin SDK가 처리하므로 클라이언트 delete는 열지 않는다.
    match /users/{uid} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if false;

      // AI Chat 사용량 상세/월별 집계는 서버가 검증한 payload만 반영해야 한다.
      // 클라이언트는 본인의 사용량을 조회할 수 있지만, 비용/제한 판단 근거를 직접 조작할 수 없어야 한다.
      match /chat_usage_sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /chat_usage_monthly/{periodId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // 학습 상태, 세션 메모리, 플래시카드, 통계, 알림 설정 등 사용자 소유 하위 데이터입니다.
      // 현재 앱은 local-first sync 구조라 여러 하위 컬렉션을 batch/set/delete로 갱신한다.
      // 단, 서버 전용 사용량 컬렉션은 위 match에서만 다루도록 제외해 클라이언트 조작을 막는다.
      match /{collectionId}/{documentId} {
        allow read, write: if isOwner(uid)
          && isClientWritableUserCollection(collectionId);
      }

      // 일부 기능은 하위 문서 구조가 더 깊어질 수 있으므로 recursive path도 같은 소유권 정책을 적용한다.
      // 첫 번째 하위 컬렉션명을 기준으로 서버 전용 usage 경로는 계속 제외한다.
      match /{collectionId}/{documentId}/{documentPath=**} {
        allow read, write: if isOwner(uid)
          && isClientWritableUserCollection(collectionId);
      }
    }

    // Google Play 대응용 AI 생성 콘텐츠 신고 저장소입니다.
    // 사용자는 앱 안에서 신고를 생성할 수만 있고, 신고 목록 조회/수정/삭제는 운영 도구 또는 Admin SDK 영역이다.
    match /ai_content_reports/{reportId} {
      allow create: if isValidAiContentReportCreate();
      allow read, update, delete: if false;
    }

    // 개발용 prompt review 전역 인덱스입니다.
    // 세션 본문은 users/{uid}/chat_prompt_reviews에 있고, 이 루트 인덱스는 사람이 리뷰 대상을 찾기 위한 얇은 문서다.
    // release 운영 데이터와 섞지 않도록 장기적으로는 관리자 도구/Functions 경유로 전환하는 것이 좋다.
    match /chat_prompt_review_reports/{reportId} {
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, delete: if false;
    }

    // 위에서 명시하지 않은 모든 경로는 기본 차단한다.
    // 새 컬렉션을 추가할 때는 이 catch-all을 열지 말고, 해당 경로의 소유권 규칙을 따로 작성한다.
    match /{documentPath=**} {
      allow read, write: if false;
    }
  }
}
